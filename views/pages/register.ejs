<!DOCTYPE html>
<html lang="th">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/bg-effects') %>
  <%- include('../partials/header') %>

  <main class="container">
    <section class="auth-card" data-animate>
      <div class="card-icon">✨</div>
      <h1>สมัครสมาชิก</h1>
      <p class="subtitle">สร้างบัญชีใหม่เพื่อเริ่มใช้งาน</p>

      <% if (error) { %>
        <div class="alert alert-error">⚠️ <%= error %></div>
      <% } %>

      <form action="/register" method="POST" class="auth-form">
        <div class="form-group">
          <label for="name">👤 ชื่อ-นามสกุล</label>
          <div class="input-wrap">
            <div class="input-glow"></div>
            <input
              type="text"
              id="name"
              name="name"
              value="<%= form.name || '' %>"
              placeholder="ชื่อของคุณ"
              required
            >
          </div>
        </div>

        <div class="form-group">
          <label for="email">📧 อีเมล</label>
          <div class="input-wrap">
            <div class="input-glow"></div>
            <input
              type="email"
              id="email"
              name="email"
              value="<%= form.email || '' %>"
              placeholder="example@email.com"
              required
            >
          </div>
        </div>

        <div class="form-group">
          <label for="password">🔑 รหัสผ่าน</label>
          <div class="input-wrap">
            <div class="input-glow"></div>
            <input
              type="password"
              id="password"
              name="password"
              placeholder="อย่างน้อย 6 ตัวอักษร"
              required
            >
            <button type="button" class="toggle-password" data-toggle-password="#password" aria-label="แสดงรหัสผ่าน">👁️</button>
          </div>
        </div>

        <div class="form-group">
          <label for="confirmPassword">🔒 ยืนยันรหัสผ่าน</label>
          <div class="input-wrap">
            <div class="input-glow"></div>
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              placeholder="กรอกรหัสผ่านอีกครั้ง"
              required
            >
            <button type="button" class="toggle-password" data-toggle-password="#confirmPassword" aria-label="แสดงรหัสผ่าน">👁️</button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block">สมัครสมาชิก →</button>
      </form>

      <p class="auth-link">
        มีบัญชีอยู่แล้ว? <a href="/login">เข้าสู่ระบบ</a>
      </p>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
