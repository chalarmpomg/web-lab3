<!DOCTYPE html>
<html lang="th">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/bg-effects') %>
  <%- include('../partials/header') %>

  <main class="container">
    <section class="auth-card" data-animate>
      <div class="card-icon">🔐</div>
      <h1>เข้าสู่ระบบ</h1>
      <p class="subtitle">กรอกอีเมลและรหัสผ่านเพื่อเข้าใช้งาน</p>

      <% if (error) { %>
        <div class="alert alert-error">⚠️ <%= error %></div>
      <% } %>

      <form action="/login" method="POST" class="auth-form">
        <div class="form-group">
          <label for="email">📧 อีเมล</label>
          <div class="input-wrap">
            <div class="input-glow"></div>
            <input
              type="email"
              id="email"
              name="email"
              value="<%= form.email || '' %>"
              placeholder="example@email.com"
              required
            >
          </div>
        </div>

        <div class="form-group">
          <label for="password">🔑 รหัสผ่าน</label>
          <div class="input-wrap">
            <div class="input-glow"></div>
            <input
              type="password"
              id="password"
              name="password"
              placeholder="รหัสผ่านของคุณ"
              required
            >
            <button type="button" class="toggle-password" data-toggle-password="#password" aria-label="แสดงรหัสผ่าน">👁️</button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block">เข้าสู่ระบบ →</button>
      </form>

      <p class="auth-link">
        ยังไม่มีบัญชี? <a href="/register">สมัครสมาชิก</a>
      </p>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
